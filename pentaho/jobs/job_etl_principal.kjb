    <entry>
      
      
      <name>10 Validar entrada da FATO</name>
      
      
      <description/>
      
      
      <type>SQL</type>
      
      
      <sql>DO $tabd$
DECLARE
    n_arcos INTEGER;
    n_sagas INTEGER;
    n_anos INTEGER;
    n_dim_arcos INTEGER;
    n_stage INTEGER;
    n_ligacoes INTEGER;
    n_incompletos INTEGER;
BEGIN
    SELECT count(*) INTO n_arcos FROM oltp.arco;
    SELECT count(*) INTO n_sagas FROM dw.dim_saga;
    SELECT count(*) INTO n_anos FROM dw.dim_tempo;
    SELECT count(*) INTO n_dim_arcos FROM dw.dim_arco;
    SELECT count(*) INTO n_stage FROM staging.stg_vdem_arco;

    IF n_arcos &lt;&gt; 32 OR n_sagas &lt;&gt; 11 OR n_anos &lt;&gt; 28
       OR n_dim_arcos &lt;&gt; 32 OR n_stage &lt;&gt; 32 THEN
        RAISE EXCEPTION 'Fontes incompletas: OLTP arcos=%, DIM_SAGA=%, DIM_TEMPO=%, DIM_ARCO=%, STG_VDEM_ARCO=% (esperados 32,11,28,32,32)',
            n_arcos,n_sagas,n_anos,n_dim_arcos,n_stage;
    END IF;

    -- LEFT JOIN verifica cada referencia sem esconder registros ausentes.
    WITH ligacoes AS (
      SELECT a.id_arco, a.id_saga, a.ano_inicio, a.ano_fim,
             da.sk_arco, ds.sk_saga, ti.sk_tempo AS sk_tempo_inicio,
             tf.sk_tempo AS sk_tempo_fim, v.id_arco_origem,
             v.op_real, v.des_real, v.dis_real, v.part_civil_real,
             da.nome_arco AS nome_dim_arco, ds.nome_saga AS nome_dim_saga,
             a.nome_arco AS nome_oltp_arco, s.nome_saga AS nome_oltp_saga
      FROM oltp.arco a
      JOIN oltp.saga s ON s.id_saga = a.id_saga
      LEFT JOIN dw.dim_arco da ON da.id_arco_origem = a.id_arco
      LEFT JOIN dw.dim_saga ds ON ds.id_saga_origem = a.id_saga
      LEFT JOIN dw.dim_tempo ti ON ti.ano = a.ano_inicio
      LEFT JOIN dw.dim_tempo tf ON tf.ano = a.ano_fim
      LEFT JOIN staging.stg_vdem_arco v ON v.id_arco_origem = a.id_arco
    )
    SELECT count(*),
      count(*) FILTER (
         WHERE sk_arco IS NULL OR sk_saga IS NULL
            OR sk_tempo_inicio IS NULL OR sk_tempo_fim IS NULL
            OR id_arco_origem IS NULL OR op_real IS NULL
            OR des_real IS NULL OR dis_real IS NULL OR part_civil_real IS NULL
            OR nome_dim_arco IS DISTINCT FROM nome_oltp_arco
            OR nome_dim_saga IS DISTINCT FROM nome_oltp_saga
      )
    INTO n_ligacoes,n_incompletos FROM ligacoes;

    IF n_ligacoes &lt;&gt; 32 OR n_incompletos &lt;&gt; 0 THEN
        RAISE EXCEPTION 'Integracao incompleta: ligacoes=% (esperado 32), linhas invalidas=% (esperado 0)',
             n_ligacoes,n_incompletos;
    END IF;
    RAISE NOTICE 'OK: fontes prontas; 32 arcos com dimensoes e indicadores V-Dem completos.';
END
$tabd$;</sql>
      
      
