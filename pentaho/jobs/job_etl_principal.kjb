    <entry>
      
      
      <name>09 Validar VDEM por arco</name>
      
      
      <description/>
      
      
      <type>SQL</type>
      
      
      <sql>DO $tabd$
DECLARE
  total_origem INTEGER;
  total_anos INTEGER;
  total_ligacoes INTEGER;
  total_destino INTEGER;
  falhas INTEGER;
BEGIN
  SELECT COUNT(*) INTO total_origem FROM oltp.arco;
  SELECT COUNT(*) INTO total_anos FROM staging.stg_vdem_anual;
  SELECT COUNT(*) INTO total_destino FROM staging.stg_vdem_arco;

  IF total_origem &lt;&gt; 32 OR total_anos &lt;&gt; 28 OR total_destino &lt;&gt; 32 THEN
    RAISE EXCEPTION 'Quantidades incorretas: origem=%, anual=%, arco=% (esperado 32,28,32)',
      total_origem, total_anos, total_destino;
  END IF;

  -- Nao podemos aceitar lacunas anuais: 1 registro por ano de publicacao, inclusive.
  SELECT COUNT(*) INTO falhas
  FROM oltp.arco a
  CROSS JOIN LATERAL generate_series(a.ano_inicio::int,a.ano_fim::int) AS ano_ref(ano_esperado)
  LEFT JOIN staging.stg_vdem_anual v ON v.year = ano_ref.ano_esperado
  WHERE v.year IS NULL;
  IF falhas &gt; 0 THEN
    RAISE EXCEPTION 'Existem % combinacoes arco-ano sem indicador anual', falhas;
  END IF;

  -- NULL representa observacao ausente, nao zero. O recorte atual deve ser completo.
  SELECT COUNT(*) INTO falhas FROM staging.stg_vdem_anual
  WHERE op_real IS NULL OR des_real IS NULL OR dis_real IS NULL OR part_civil_real IS NULL;
  IF falhas &gt; 0 THEN
    RAISE EXCEPTION 'A staging anual tem % linhas com indicadores NULL',falhas;
  END IF;

  SELECT COUNT(*) INTO total_ligacoes
  FROM oltp.arco a
  JOIN staging.stg_vdem_anual v ON v.year BETWEEN a.ano_inicio AND a.ano_fim;
  IF total_ligacoes &lt;&gt; 58 THEN
    RAISE EXCEPTION 'Combinacoes arco-ano=% (esperado 58)', total_ligacoes;
  END IF;

  -- Todos os arcos devem ter exatamente uma linha correspondente no staging.
  SELECT COUNT(*) INTO falhas
  FROM oltp.arco a LEFT JOIN staging.stg_vdem_arco s ON s.id_arco_origem=a.id_arco
  WHERE s.id_arco_origem IS NULL;
  IF falhas &gt; 0 THEN
    RAISE EXCEPTION 'Existem % arcos sem indicador na staging por arco',falhas;
  END IF;

  -- Recalcula independentemente as medias por arco no PostgreSQL.
  WITH esperado AS (
    SELECT a.id_arco AS id_arco_origem,
      ROUND(AVG(v.op_real),6) AS op_real,
      ROUND(AVG(v.des_real),6) AS des_real,
      ROUND(AVG(v.dis_real),6) AS dis_real,
      ROUND(AVG(v.part_civil_real),6) AS part_civil_real
    FROM oltp.arco a
    JOIN staging.stg_vdem_anual v ON v.year BETWEEN a.ano_inicio AND a.ano_fim
    GROUP BY a.id_arco
  )
  SELECT COUNT(*) INTO falhas
  FROM esperado e
  JOIN staging.stg_vdem_arco s USING (id_arco_origem)
  WHERE e.op_real IS DISTINCT FROM s.op_real
     OR e.des_real IS DISTINCT FROM s.des_real
     OR e.dis_real IS DISTINCT FROM s.dis_real
     OR e.part_civil_real IS DISTINCT FROM s.part_civil_real;
  IF falhas &gt; 0 THEN
    RAISE EXCEPTION 'Foram encontrados % arcos cujas medias divergem do recálculo', falhas;
  END IF;

  RAISE NOTICE 'OK: % arcos, % combinacoes arco-ano e 4 indicadores conferidos (6 casas).',
      total_destino,total_ligacoes;
END
$tabd$;</sql>
      
      
