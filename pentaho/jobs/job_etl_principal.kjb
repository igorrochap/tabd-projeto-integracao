      <description/>
      
      
      <type>TRANS</type>
      
      
      <specification_method>filename</specification_method>
      
      
      <trans_object_id/>
      
      
      <filename>${Internal.Job.Filename.Directory}/../transformations/tr_fato_sociopolitica.ktr</filename>
      
      
