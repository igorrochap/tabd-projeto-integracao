    <entry>
      
      
      <name>07 Validar VDEM anual</name>
      
      
      <description/>
      
      
      <type>SQL</type>
      
      
      <sql>DO $tabd$
DECLARE n int;
BEGIN
  SELECT COUNT(*) INTO n FROM staging.stg_vdem_anual;
  IF n &lt;&gt; 28 THEN RAISE EXCEPTION 'V-Dem anual: % linhas (esperado 28)',n; END IF;
  IF EXISTS (
    SELECT 1 FROM generate_series(1997,2024) AS y(ano)
    LEFT JOIN staging.stg_vdem_anual v ON v.year=y.ano WHERE v.year IS NULL
  ) THEN RAISE EXCEPTION 'V-Dem anual: ano ausente'; END IF;
  IF EXISTS (
     SELECT 1 FROM staging.stg_vdem_anual v
     WHERE v.v2x_clpol IS NULL OR v.v2xeg_eqdr IS NULL OR v.v2xeg_eqprotec IS NULL
       OR v.v2x_cspart IS NULL OR v.op_real IS NULL OR v.des_real IS NULL
       OR v.dis_real IS NULL OR v.part_civil_real IS NULL
       OR v.op_real &lt;&gt; 1-v.v2x_clpol OR v.des_real &lt;&gt; 1-v.v2xeg_eqdr
       OR v.dis_real &lt;&gt; 1-v.v2xeg_eqprotec OR v.part_civil_real&lt;&gt;v.v2x_cspart
       OR v.qtd_paises_v2x_clpol &lt;= 0 OR v.qtd_paises_v2xeg_eqdr &lt;= 0
       OR v.qtd_paises_v2xeg_eqprotec &lt;= 0 OR v.qtd_paises_v2x_cspart &lt;= 0
  ) THEN RAISE EXCEPTION 'V-Dem anual: indicador ou contagem invalida'; END IF;
  RAISE NOTICE 'OK STAGING ANUAL: 28 anos e 13 campos validos.';
END
$tabd$;</sql>
      
      
