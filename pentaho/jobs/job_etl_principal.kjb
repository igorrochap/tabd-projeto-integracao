    <entry>
      
      
      <name>01 Validar OLTP</name>
      
      
      <description/>
      
      
      <type>SQL</type>
      
      
      <sql>DO $tabd$
DECLARE
    n_saga int; n_arco int; n_cap int;
BEGIN
    SELECT COUNT(*) INTO n_saga FROM oltp.saga;
    SELECT COUNT(*) INTO n_arco FROM oltp.arco;
    SELECT COALESCE(SUM(qtd_capitulos),0) INTO n_cap FROM oltp.arco;
    IF n_saga &lt;&gt; 11 OR n_arco &lt;&gt; 32 OR n_cap &lt;&gt; 1125 THEN
       RAISE EXCEPTION 'OLTP incompleto: % sagas, % arcos, % capitulos (esperado 11/32/1125)', n_saga,n_arco,n_cap;
    END IF;
    IF EXISTS (SELECT 1 FROM oltp.arco WHERE ano_inicio&gt;ano_fim OR isa_final&lt;&gt;op_final+des_final+dis_final+res_final) THEN
       RAISE EXCEPTION 'Inconsistencia de periodo ou ISA na fonte One Piece';
    END IF;
    RAISE NOTICE 'OK PRE: OLTP com 11 sagas, 32 arcos e 1125 capitulos.';
END
$tabd$;</sql>
      
      
