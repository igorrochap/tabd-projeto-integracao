    <entry>
      
      
      <name>12 Validar DW final</name>
      
      
      <description/>
      
      
      <type>SQL</type>
      
      
      <sql>DO $tabd$
DECLARE
  n_fato INTEGER;
  n_arcos INTEGER;
  n_integrados INTEGER;
  n_divergencias INTEGER;
  n_soma_capitulos INTEGER;
BEGIN
  SELECT count(*) INTO n_fato FROM dw.fato_sociopolitica_arco;
  SELECT count(*) INTO n_arcos FROM oltp.arco;
  IF n_fato &lt;&gt; 32 OR n_arcos &lt;&gt; 32 THEN
    RAISE EXCEPTION 'Quantidade de registros: fato=%, origem=% (esperado 32 em cada)',n_fato,n_arcos;
  END IF;

  -- Todas as dimensoes e o V-Dem precisam estar mapeados para o mesmo arco.
  WITH esperado AS (
    SELECT
      da.sk_arco, ds.sk_saga,
      ti.sk_tempo AS sk_tempo_inicio, tf.sk_tempo AS sk_tempo_fim,
      a.qtd_capitulos,
      (a.ano_fim - a.ano_inicio + 1)::smallint AS duracao_publicacao_anos,
      a.op_final,a.des_final,a.dis_final,a.res_final,a.isa_final,
      v.op_real,v.des_real,v.dis_real,v.part_civil_real,
      1::smallint AS qtd_arcos
    FROM oltp.arco a
    JOIN dw.dim_arco da ON da.id_arco_origem=a.id_arco
    JOIN dw.dim_saga ds ON ds.id_saga_origem=a.id_saga
    JOIN dw.dim_tempo ti ON ti.ano=a.ano_inicio
    JOIN dw.dim_tempo tf ON tf.ano=a.ano_fim
    JOIN staging.stg_vdem_arco v ON v.id_arco_origem=a.id_arco
  )
  SELECT count(*) INTO n_integrados FROM esperado;
  IF n_integrados &lt;&gt; 32 THEN
    RAISE EXCEPTION 'A consulta de integracao resulta em % linhas (esperado 32)', n_integrados;
  END IF;

  WITH esperado AS (
    SELECT
      da.sk_arco, ds.sk_saga,
      ti.sk_tempo AS sk_tempo_inicio, tf.sk_tempo AS sk_tempo_fim,
      a.qtd_capitulos,
      (a.ano_fim - a.ano_inicio + 1)::smallint AS duracao_publicacao_anos,
      a.op_final,a.des_final,a.dis_final,a.res_final,a.isa_final,
      v.op_real,v.des_real,v.dis_real,v.part_civil_real,
      1::smallint AS qtd_arcos
    FROM oltp.arco a
    JOIN dw.dim_arco da ON da.id_arco_origem=a.id_arco
    JOIN dw.dim_saga ds ON ds.id_saga_origem=a.id_saga
    JOIN dw.dim_tempo ti ON ti.ano=a.ano_inicio
    JOIN dw.dim_tempo tf ON tf.ano=a.ano_fim
    JOIN staging.stg_vdem_arco v ON v.id_arco_origem=a.id_arco
  )
  SELECT count(*) INTO n_divergencias
  FROM esperado e
  FULL JOIN dw.fato_sociopolitica_arco f ON f.sk_arco=e.sk_arco
  WHERE e.sk_arco IS NULL OR f.sk_arco IS NULL
     OR f.sk_saga IS DISTINCT FROM e.sk_saga
     OR f.sk_tempo_inicio IS DISTINCT FROM e.sk_tempo_inicio
     OR f.sk_tempo_fim IS DISTINCT FROM e.sk_tempo_fim
     OR f.qtd_capitulos IS DISTINCT FROM e.qtd_capitulos
     OR f.duracao_publicacao_anos IS DISTINCT FROM e.duracao_publicacao_anos
     OR f.op_final IS DISTINCT FROM e.op_final
     OR f.des_final IS DISTINCT FROM e.des_final
     OR f.dis_final IS DISTINCT FROM e.dis_final
     OR f.res_final IS DISTINCT FROM e.res_final
     OR f.isa_final IS DISTINCT FROM e.isa_final
     OR f.op_real IS DISTINCT FROM e.op_real
     OR f.des_real IS DISTINCT FROM e.des_real
     OR f.dis_real IS DISTINCT FROM e.dis_real
     OR f.part_civil_real IS DISTINCT FROM e.part_civil_real
     OR f.qtd_arcos IS DISTINCT FROM e.qtd_arcos;
  IF n_divergencias &lt;&gt; 0 THEN
    RAISE EXCEPTION 'Fato possui % linhas ausentes, extras ou com valores divergentes',n_divergencias;
  END IF;

  IF EXISTS (
       SELECT sk_arco FROM dw.fato_sociopolitica_arco GROUP BY sk_arco HAVING count(*) &gt; 1
  ) THEN
       RAISE EXCEPTION 'Duplicidade de sk_arco na tabela fato';
  END IF;
  IF EXISTS (
       SELECT 1 FROM dw.fato_sociopolitica_arco
       WHERE op_real IS NULL OR des_real IS NULL
          OR dis_real IS NULL OR part_civil_real IS NULL
          OR qtd_arcos &lt;&gt; 1
          OR isa_final &lt;&gt; op_final + des_final + dis_final + res_final
  ) THEN
       RAISE EXCEPTION 'Fato contem indicadores ausentes ou medidas inconsistentes';
  END IF;
  SELECT sum(qtd_capitulos) INTO n_soma_capitulos FROM dw.fato_sociopolitica_arco;
  IF n_soma_capitulos &lt;&gt; 1125 THEN
     RAISE EXCEPTION 'Soma de capitulos=% (esperado 1125)',n_soma_capitulos;
  END IF;
  RAISE NOTICE 'OK: 32 linhas na FATO; 16 campos integrados conferidos, 1125 capitulos, sem duplicidades nem divergencias.';
END
$tabd$;</sql>
      
      
