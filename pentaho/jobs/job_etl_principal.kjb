    <entry>
      
      
      <name>05 Validar dimensoes</name>
      
      
      <description/>
      
      
      <type>SQL</type>
      
      
      <sql>DO $tabd$
BEGIN
 IF (SELECT COUNT(*) FROM dw.dim_tempo) &lt;&gt; 28 OR
    (SELECT COUNT(*) FROM dw.dim_saga) &lt;&gt; 11 OR
    (SELECT COUNT(*) FROM dw.dim_arco) &lt;&gt; 32 THEN
   RAISE EXCEPTION 'Quantidade incorreta em DIM_TEMPO, DIM_SAGA ou DIM_ARCO';
 END IF;
 IF EXISTS (SELECT y.ano FROM generate_series(1997,2024) y(ano)
            LEFT JOIN dw.dim_tempo d ON d.ano=y.ano
            WHERE d.sk_tempo IS NULL OR d.decada&lt;&gt;(y.ano/10)*10) THEN
   RAISE EXCEPTION 'DIM_TEMPO inconsistente';
 END IF;
 IF EXISTS (SELECT 1 FROM oltp.saga s LEFT JOIN dw.dim_saga d
            ON d.id_saga_origem=s.id_saga
            WHERE d.sk_saga IS NULL OR d.nome_saga IS DISTINCT FROM s.nome_saga)
    OR EXISTS (SELECT 1 FROM oltp.arco a LEFT JOIN dw.dim_arco d
            ON d.id_arco_origem=a.id_arco
            WHERE d.sk_arco IS NULL OR d.nome_arco IS DISTINCT FROM a.nome_arco) THEN
   RAISE EXCEPTION 'DIM_ARCO/DIM_SAGA divergem do OLTP';
 END IF;
 RAISE NOTICE 'OK DIMENSOES: 28 anos, 11 sagas, 32 arcos.';
END
$tabd$;</sql>
      
      
