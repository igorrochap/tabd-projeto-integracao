      <to>07 Comparar com referencia</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>07 Comparar com referencia</from>
      <to>08 Calcular divergencias</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>08 Calcular divergencias</from>
      <to>09 Diverge da referencia?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>09 Diverge da referencia?</from>
      <to>10 Abortar se divergente</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>09 Diverge da referencia?</from>
      <to>11 Inserir ou atualizar</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>01 Ler CSV pais-ano</name>
    <type>CsvInput</type>
    <description>Le os 4.985 registros do CSV reduzido, com separador virgula e cabecalho.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${Internal.Transformation.Filename.Directory}/../../data/vdem_reduzido_pais_ano.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <format/>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>country_id</name>
        <type>Integer</type>
        <format>#</format>
        <currency>R$</currency>
        <decimal>,</decimal>
        <group>.</group>
        <length>15</length>
        <precision>0</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>country_text_id</name>
        <type>String</type>
        <format/>
        <currency>R$</currency>
        <decimal>,</decimal>
        <group>.</group>
        <length>3</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>country_name</name>
        <type>String</type>
        <format/>
        <currency>R$</currency>
        <decimal>,</decimal>
        <group>.</group>
        <length>24</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>year</name>
        <type>Integer</type>
        <format>#</format>
        <currency>R$</currency>
        <decimal>,</decimal>
        <group>.</group>
        <length>15</length>
        <precision>0</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>v2x_clpol</name>
        <type>Number</type>
        <format>#.#</format>
        <currency>R$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>15</length>
        <precision>0</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>v2xeg_eqdr</name>
        <type>Number</type>
        <format>#.#</format>
        <currency>R$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>15</length>
        <precision>0</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>v2xeg_eqprotec</name>
        <type>Number</type>
        <format>#.#</format>
        <currency>R$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>15</length>
        <precision>0</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>v2x_cspart</name>
        <type>Number</type>
        <format>#.#</format>
        <currency>R$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>15</length>
        <precision>0</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>90</xloc>
      <yloc>200</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>02 Ordenar pelo ano</name>
    <type>SortRows</type>
    <description>Ordenacao obrigatoria antes do Group By.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <directory>${java.io.tmpdir}</directory>
    <prefix>tabd_sort_vdem</prefix>
    <sort_size>100000</sort_size>
    <free_memory/>
    <compress>N</compress>
    <compress_variable/>
    <unique_rows>N</unique_rows>
    <fields>
      <field>
        <name>year</name>
        <ascending>Y</ascending>
        <case_sensitive>N</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>340</xloc>
      <yloc>200</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>03 Calcular medias mundiais</name>
    <type>GroupBy</type>
    <description>Media aritmetica de valores validos por ano e contagens nao nulas.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore/>
    <directory>${java.io.tmpdir}</directory>
    <prefix>tabd_group_vdem</prefix>
    <add_linenr>N</add_linenr>
    <linenr_fieldname/>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>year</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>avg_v2x_clpol</aggregate>
        <subject>v2x_clpol</subject>
        <type>AVERAGE</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>qtd_paises_v2x_clpol</aggregate>
        <subject>v2x_clpol</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>avg_v2xeg_eqdr</aggregate>
        <subject>v2xeg_eqdr</subject>
        <type>AVERAGE</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>qtd_paises_v2xeg_eqdr</aggregate>
        <subject>v2xeg_eqdr</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>avg_v2xeg_eqprotec</aggregate>
        <subject>v2xeg_eqprotec</subject>
        <type>AVERAGE</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>qtd_paises_v2xeg_eqprotec</aggregate>
        <subject>v2xeg_eqprotec</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>avg_v2x_cspart</aggregate>
        <subject>v2x_cspart</subject>
        <type>AVERAGE</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>qtd_paises_v2x_cspart</aggregate>
        <subject>v2x_cspart</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>585</xloc>
      <yloc>200</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>04 Adicionar constantes</name>
    <type>Constant</type>
    <description>Constantes 1 e 5 para inversao e arredondamento.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
