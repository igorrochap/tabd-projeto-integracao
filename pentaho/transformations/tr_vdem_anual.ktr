  <order>
    <hop>
      <from>01 Ler CSV pais-ano</from>
      <to>02 Ordenar pelo ano</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>02 Ordenar pelo ano</from>
      <to>03 Calcular medias mundiais</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>03 Calcular medias mundiais</from>
      <to>04 Adicionar constantes</to>
