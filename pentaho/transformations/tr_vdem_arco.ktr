<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tr_vdem_arco</name>
    <description>Integra os indicadores mundiais anuais do V-Dem aos periodos dos 32 arcos de One Piece.</description>
    <extended_description>Le 58 combinacoes arco-ano, calcula a media aritmetica simples por arco, arredonda a 6 casas e faz upsert em staging.stg_vdem_arco. Um registro final por id_arco_origem.</extended_description>
    <trans_version>1</trans_version>
    <trans_type>Normal</trans_type>
