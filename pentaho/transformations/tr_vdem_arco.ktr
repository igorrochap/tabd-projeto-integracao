  <step>
    <name>01 Relacionar arcos e anos</name>
    <type>TableInput</type>
    <description>Combina cada arco com todos os anos anuais no intervalo inclusivo de publicacao.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>POSTGRES_TABD</connection>
    <sql>SELECT
    a.id_arco AS id_arco_origem,
    v.year,
    v.op_real::DOUBLE PRECISION AS op_real_anual,
    v.des_real::DOUBLE PRECISION AS des_real_anual,
    v.dis_real::DOUBLE PRECISION AS dis_real_anual,
    v.part_civil_real::DOUBLE PRECISION AS part_civil_real_anual
FROM oltp.arco AS a
INNER JOIN staging.stg_vdem_anual AS v
    ON v.year BETWEEN a.ano_inicio AND a.ano_fim
ORDER BY a.id_arco, v.year</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>90</xloc>
      <yloc>180</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>02 Ordenar por arco</name>
    <type>SortRows</type>
    <description>Ordena pelo identificador do arco para agrupamento por arco.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <directory>${java.io.tmpdir}</directory>
    <prefix>tabd_sort_vdem_arco</prefix>
    <sort_size>100000</sort_size>
    <free_memory/>
    <compress>N</compress>
    <compress_variable/>
    <unique_rows>N</unique_rows>
    <fields>
      <field>
        <name>id_arco_origem</name>
        <ascending>Y</ascending>
        <case_sensitive>N</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>345</xloc>
      <yloc>180</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>03 Medias do periodo</name>
    <type>GroupBy</type>
    <description>Uma media por indicador para cada arco (cada ano tem o mesmo peso).</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore/>
    <directory>${java.io.tmpdir}</directory>
    <prefix>tabd_group_vdem_arco</prefix>
    <add_linenr>N</add_linenr>
    <linenr_fieldname/>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>id_arco_origem</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>media_op_real</aggregate>
        <subject>op_real_anual</subject>
        <type>AVERAGE</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>media_des_real</aggregate>
        <subject>des_real_anual</subject>
        <type>AVERAGE</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>media_dis_real</aggregate>
        <subject>dis_real_anual</subject>
        <type>AVERAGE</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>media_part_civil_real</aggregate>
        <subject>part_civil_real_anual</subject>
        <type>AVERAGE</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>anos_encontrados</aggregate>
        <subject>year</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>610</xloc>
      <yloc>180</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>04 Adicionar precisao</name>
    <type>Constant</type>
    <description>Define 6 casas para armazenamento NUMERIC(7,6).</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>casas_decimais</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <nullif>6</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>855</xloc>
      <yloc>180</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>05 Arredondar indicadores</name>
    <type>Calculator</type>
    <description>Arredondamento HALF_UP de cada media a 6 casas antes do upsert.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <failIfNoFile>Y</failIfNoFile>
    <calculation>
      <field_name>op_real</field_name>
      <calc_type>ROUND_STD_2</calc_type>
      <field_a>media_op_real</field_a>
      <field_b>casas_decimais</field_b>
      <field_c/>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>6</value_precision>
      <remove>N</remove>
      <conversion_mask/>
      <decimal_symbol>.</decimal_symbol>
      <grouping_symbol/>
      <currency_symbol/>
    </calculation>
    <calculation>
      <field_name>des_real</field_name>
      <calc_type>ROUND_STD_2</calc_type>
      <field_a>media_des_real</field_a>
      <field_b>casas_decimais</field_b>
      <field_c/>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>6</value_precision>
      <remove>N</remove>
      <conversion_mask/>
      <decimal_symbol>.</decimal_symbol>
      <grouping_symbol/>
      <currency_symbol/>
    </calculation>
    <calculation>
      <field_name>dis_real</field_name>
      <calc_type>ROUND_STD_2</calc_type>
      <field_a>media_dis_real</field_a>
      <field_b>casas_decimais</field_b>
      <field_c/>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>6</value_precision>
      <remove>N</remove>
      <conversion_mask/>
      <decimal_symbol>.</decimal_symbol>
      <grouping_symbol/>
      <currency_symbol/>
    </calculation>
    <calculation>
      <field_name>part_civil_real</field_name>
      <calc_type>ROUND_STD_2</calc_type>
      <field_a>media_part_civil_real</field_a>
      <field_b>casas_decimais</field_b>
      <field_c/>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>6</value_precision>
      <remove>N</remove>
      <conversion_mask/>
      <decimal_symbol>.</decimal_symbol>
      <grouping_symbol/>
      <currency_symbol/>
    </calculation>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1090</xloc>
      <yloc>180</yloc>
      <draw>Y</draw>
    </GUI>
