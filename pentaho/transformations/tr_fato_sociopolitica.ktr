        <update>Y</update>
      </value>
      <value>
        <name>qtd_capitulos</name>
        <rename>qtd_capitulos</rename>
        <update>Y</update>
      </value>
      <value>
        <name>duracao_publicacao_anos</name>
        <rename>duracao_publicacao_anos</rename>
        <update>Y</update>
      </value>
      <value>
        <name>op_final</name>
        <rename>op_final</rename>
        <update>Y</update>
      </value>
      <value>
        <name>des_final</name>
        <rename>des_final</rename>
        <update>Y</update>
      </value>
      <value>
