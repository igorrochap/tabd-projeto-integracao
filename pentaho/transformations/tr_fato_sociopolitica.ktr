  <order>
    <hop>
      <from>01 Integrar fontes e dimensoes</from>
      <to>02 Inserir ou atualizar fato</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>01 Integrar fontes e dimensoes</name>
    <type>TableInput</type>
    <description>Uma linha por arco; associa chaves substitutas e indicadores reais previamente tratados.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>POSTGRES_TABD</connection>
    <sql>SELECT
    da.sk_arco,
    ds.sk_saga,
    ti.sk_tempo AS sk_tempo_inicio,
    tf.sk_tempo AS sk_tempo_fim,
    a.qtd_capitulos,
    (a.ano_fim - a.ano_inicio + 1)::SMALLINT AS duracao_publicacao_anos,
    a.op_final,
    a.des_final,
    a.dis_final,
    a.res_final,
    a.isa_final,
    v.op_real,
    v.des_real,
    v.dis_real,
    v.part_civil_real,
    1::SMALLINT AS qtd_arcos
FROM oltp.arco AS a
JOIN dw.dim_arco AS da
    ON da.id_arco_origem = a.id_arco
JOIN dw.dim_saga AS ds
    ON ds.id_saga_origem = a.id_saga
JOIN dw.dim_tempo AS ti
    ON ti.ano = a.ano_inicio
JOIN dw.dim_tempo AS tf
    ON tf.ano = a.ano_fim
JOIN staging.stg_vdem_arco AS v
    ON v.id_arco_origem = a.id_arco
ORDER BY a.id_arco</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>140</xloc>
      <yloc>170</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>02 Inserir ou atualizar fato</name>
    <type>InsertUpdate</type>
    <description>Lookup por sk_arco, UNIQUE no DW. PostgreSQL gera sk_fato; demais colunas sao atualizadas quando valores mudam.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>POSTGRES_TABD</connection>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema>dw</schema>
      <table>fato_sociopolitica_arco</table>
      <key>
        <name>sk_arco</name>
        <field>sk_arco</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>sk_arco</name>
        <rename>sk_arco</rename>
        <update>N</update>
      </value>
      <value>
