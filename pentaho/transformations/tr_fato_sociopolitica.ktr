<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tr_fato_sociopolitica</name>
    <description>Carga idempotente da tabela fato: dados One Piece + indicadores do V-Dem na granularidade de um arco.</description>
    <extended_description>Associa as dimensoes arco, saga e tempo por chaves naturais; une a staging V-Dem por id_arco; copia as medidas de One Piece e V-Dem; insere ou atualiza a fato usando sk_arco como chave. Validacoes: entries "10 Validar entrada da FATO" (antes) e "12 Validar DW final" (depois) do job_etl_principal.kjb.</extended_description>
    <trans_version>1</trans_version>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
